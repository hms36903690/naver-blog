# ─────────────────────────────────────────────────────────────
# 열쇠(키)를 적어두는 파일의 견본입니다.
# 이 파일을 복사해 .env.local 이라는 이름으로 만든 뒤 값을 채우세요.
#   맥:     cp env.sample .env.local
#   윈도우: copy env.sample .env.local
# 값을 넣은 뒤에는 앱을 껐다 켜야 반영됩니다.
# ─────────────────────────────────────────────────────────────

# (선택) AI 사진 생성 — Cloudflare Workers AI
# 비워 두면 'AI 생성' 사진만 못 쓰고 나머지는 다 됩니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# (선택) claude 프로그램 위치를 직접 지정할 때만 씁니다. 보통은 비워 두세요.
CLAUDE_BIN=
